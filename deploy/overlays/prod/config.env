ORIGIN=https://bok.mwsz.org
# adapter-node derives the request origin from headers (it no longer reads ORIGIN).
# Traefik sets X-Forwarded-Proto/-Host; without these it assumes https + the Host header.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
LOG_LEVEL=info
EMAIL_FROM=bok <noreply@bok.mwsz.org>
ADMIN_EMAILS=szymczak.milosz@gmail.com
R2_BUCKET=bok-img
R2_PREFIX=
# Empty = covers/avatars are served by the app at /media/* (cached immutably).
# Set to a custom R2 domain (e.g. https://img.bok.mwsz.org) to serve them straight from Cloudflare.
R2_PUBLIC_URL=
# Single node: VALKEY_URL. Cluster mode: VALKEY_CLUSTER_NODES=host:port,host:port (and leave VALKEY_URL empty).
# Credentials don't go here (this is a ConfigMap) — put VALKEY_USERNAME / VALKEY_PASSWORD in secrets.env.
VALKEY_URL=redis://CHANGE-ME.valkey.svc.cluster.local:6379
VALKEY_CLUSTER_NODES=
VAPID_SUBJECT=https://bok.mwsz.org
